# Network
NETWORK_INTERFACE=eth0
DNSMASQ_LOG_PATH=/var/log/dnsmasq.log

# Detection thresholds
QUERY_RATE_LIMIT=50
NXDOMAIN_LIMIT=10
SUBDOMAIN_LIMIT=20
DGA_ENTROPY_THRESHOLD=3.5
DGA_MIN_LENGTH=12

# Blacklist
ENABLE_REMOTE_BLACKLIST=true
URLHAUS_REFRESH_HOURS=24
OPENPHISH_REFRESH_HOURS=12

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=false
DASHBOARD_UPDATE_INTERVAL=30

# Dashboard authentication
SECRET_KEY=8dd0d860886e7a0496355829924f2a5171c4ef1fd6cc4a05d979d3e921fa4a63
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
ENABLE_REGISTRATION=true

# Email (leave blank unless setting up email alerts)
ENABLE_EMAIL_ALERTS=false
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=dns-monitor@example.com
ALERT_EMAIL_TO=admin@example.com

# Performance
PROCESSING_THREADS=2
QUEUE_SIZE=1000

# Testing
TEST_MODE=false

# Logging
LOG_LEVEL=INFO
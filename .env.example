# DNS Threat Monitor - Environment Configuration
# Copy this file to .env and fill in your values

# Database
DB_PATH=./data/dns_threat_monitor.db
DB_BACKUP_PATH=./data/backups

# Capture Interface
CAPTURE_INTERFACE=eth0
CAPTURE_FILTER=udp port 53
CAPTURE_SNAPLEN=65535

# Detection
BLACKLIST_UPDATE_INTERVAL=86400  # 24 hours in seconds

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=False

# Email Alerts
EMAIL_ALERTS_ENABLED=False
EMAIL_TO=admin@example.com
EMAIL_FROM=alerts@dnsmonitor.local
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/dns_threat_monitor.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Performance
MAX_QUERY_RATE=1000
BATCH_SIZE=100
WORKER_THREADS=4


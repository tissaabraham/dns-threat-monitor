# DNS Threat Monitor environment variables
# Copy this file to .env and adjust values as needed.

# Paths and files
DB_FILENAME=dns_threat_monitor.db
THREATS_FILENAME=threats.txt
LOG_FILENAME=dns_monitor.log
LOG_LEVEL=INFO

# Capture configuration
NETWORK_INTERFACE=eth0
TECHNITIUM_LOG_PATH=/var/log/technitium/dns/queries

# Detection thresholds
QUERY_RATE_LIMIT=50
NXDOMAIN_LIMIT=10
SUBDOMAIN_LIMIT=20
DGA_ENTROPY_THRESHOLD=3.5
DGA_MIN_LENGTH=12

# Blacklist configuration
ENABLE_REMOTE_BLACKLIST=true
URLHAUS_REFRESH_HOURS=24
OPENPHISH_REFRESH_HOURS=12

# Dashboard configuration
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=false
DASHBOARD_UPDATE_INTERVAL=30

# Dashboard authentication
SECRET_KEY=dns-monitor-secret-key-change-in-production
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
ENABLE_REGISTRATION=true

# Performance configuration
PROCESSING_THREADS=2
QUEUE_SIZE=1000
MAX_DNS_LOGS_LIMIT=1000
MAX_ALERTS_LIMIT=100
DEFAULT_TIME_RANGE_HOURS=24

# System limits
MAX_CPU_PERCENT=30.0
MAX_MEMORY_MB=500
MAX_DETECTION_TIME=3.0

# Development/testing
TEST_MODE=false
TEST_DATA_FILE=test_dns_data.txt
